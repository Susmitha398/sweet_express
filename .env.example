PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sweet_shop_db

# Get these from the Razorpay Dashboard. Keep the secret only in backend/.env.
# Use test keys while developing. Use live keys only after Razorpay activates your account.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
ENABLE_RAZORPAY_TEST_PRODUCT=false
